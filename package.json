		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-slider": "^1.3.6",
		"@tailwindcss/postcss": "^4.2.1",
		"@tanstack/react-query": "^5.90.11",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cn": "^0.2.5",
		"date-fns": "^4.1.0",
		"drizzle-orm": "^0.36.0",
		"input-otp": "^1.4.2",
		"jszip": "^3.10.1",
		"lucide-react": "^1.41.0",
		"nanoid": "^5.0.9",
		"next": "^16.1.7",
		"next-auth": "^5.0.0-beta.25",
		"next-themes": "^0.4.6",
		"nodemailer": "^7.0.13",
		"pg": "^8.13.1",
		"react": "^19.2.4",
		"react-colorful": "^5.8.1",
		"react-dom": "^19.2.4",
		"react-resizable-panels": "^4.12.3",
		"server-only": "^0.0.1",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.1",
		"tailwindcss-animate": "^1.0.7",
		"three": "^0.169.0",
		"three-mesh-bvh": "^0.9.0",
		"typescript-optional": "^3.0.0-alpha.3",
		"uuid": "^13.0.0",
		"zod": "^4.3.6",
		"zustand": "^5.0.2"
	},
	"devDependencies": {
		"@types/node": "24.10.0",
		"@types/nodemailer": "^6.4.17",
		"@types/pg": "^8.11.10",
		"@types/react": "19.2.2",
		"@types/react-dom": "19.2.2",
		"@types/three": "^0.169.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9.39.1",
		"eslint-config-next": "^16.0.1",
		"postcss": "^8.5.6",
		"tsx": "^4.20.6",
		"typescript": "5.9.3"
	},
	"optionalDependencies": {
		"lightningcss": "^1.30.2"
	}
}
