{
	"name": "hairgen",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"license": "ISC",
	"scripts": {
		"start": "docker compose down -v && docker compose up -d --build --force-recreate",
		"stop": "docker compose down",
		"dev": "next dev",
		"build": "next build",
		"build:vercel": "tsx scripts/build.ts",
		"lint": "eslint .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"seed": "tsx scripts/seed.ts",
		"seed:setup": "npm run db:push && npm run seed",
		"dump-project": "tsx scripts/dumpProject.ts",
		"check": "next typegen && tsc --noEmit && eslint .",
		"check:full": "next typegen && tsc --noEmit && eslint . && next build",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@auth/drizzle-adapter": "^1.11.1",
		"@aws-sdk/client-s3": "^3.928.0",
		"@base-ui/react": "^1.7.0",
