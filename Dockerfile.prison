FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    less \
    procps \
    jq \
    ripgrep \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @openai/codex

RUN npm install -g @anthropic-ai/claude-code

RUN printf '#!/bin/sh\nexec codex --dangerously-bypass-approvals-and-sandbox "$@"\n' > /usr/local/bin/kodx \
    && chmod +x /usr/local/bin/kodx

WORKDIR /app

CMD ["tail", "-f", "/dev/null"]
